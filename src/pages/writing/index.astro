---
import type { MarkdownInstance } from "astro";
import "../../styles/global.css";
import "../../styles/docs.css";
import Navbar from "../../components/Navbar.astro";

interface Frontmatter {
    title: string;
    lead?: string;
    date?: string;
    appendix?: boolean;
}

type WritingDoc = MarkdownInstance<Frontmatter>;
const files = import.meta.glob<WritingDoc>("../../data/writing/*.md", {
    eager: true,
});
const reports = Object.values(files)
    .filter((doc) => !doc.frontmatter.appendix)
    .sort((a, b) =>
        (b.frontmatter.date ?? "").localeCompare(a.frontmatter.date ?? ""),
    );
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <title>Miles | Writing</title>
    </head>
    <body>
        <Navbar />

        <main class="docs-content">
            <h1
                class="page-title"
                style="margin-bottom: 1rem; color: var(--text-main);"
            >
                Writing
            </h1>
            <p
                style="color: var(--text-muted); margin-bottom: 3rem; line-height: 1.6;"
            >
                Stuff I've written, mostly about things I got curious about
            </p>

            <div class="docs-index-list">
                {
                    reports.map((doc) => {
                        const slug =
                            doc.file.split("/").pop()?.replace(".md", "") ||
                            "unknown";

                        return (
                            <a href={`/writing/${slug}`} class="doc-index-card">
                                <div class="doc-index-label">
                                    <h2>{doc.frontmatter.title}</h2>
                                    {doc.frontmatter.date && (
                                        <span class="doc-author">
                                            {doc.frontmatter.date}
                                        </span>
                                    )}
                                </div>
                                <span class="view-text">Read →</span>
                            </a>
                        );
                    })
                }
            </div>
        </main>
    </body>
</html>
